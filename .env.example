# Copie para .env e preencha. O arquivo .env nao vai para o Git.
# Escolha UM provedor:
GEMINI_API_KEY=
MEI_PROVEDOR=gemini
# GEMINI_MODELO=gemini-3.8-flash

# ou Claude:
# ANTHROPIC_API_KEY=
# MEI_PROVEDOR=claude

# ou OpenRouter (um modelo de qualquer fabricante, desde que aceite ferramentas):
# OPENROUTER_API_KEY=
# MEI_PROVEDOR=openrouter
# OPENROUTER_MODELO=anthropic/claude-sonnet-5.5
